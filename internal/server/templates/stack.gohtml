<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Stack }} — {{ .Repo }}</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="min-h-screen bg-base-200">
  <div class="navbar bg-base-100 border-b border-base-300">
    <div class="mx-auto w-full max-w-5xl px-4 flex items-center gap-3">
      <a href="/live/{{ .Exec }}" class="link link-hover text-sm opacity-70">← {{ .Repo }}</a>
      <span class="text-lg font-semibold"><code>{{ .Stack }}</code></span>
    </div>
  </div>
  <main class="mx-auto w-full max-w-5xl px-4 py-6">
    <section class="card bg-base-100 shadow-sm"><div class="card-body p-4">
      <div class="tabs tabs-border">
        <input type="radio" name="stacktabs" class="tab" aria-label="Log" checked>
        <div class="tab-content border-base-300 p-3">
          <pre id="stacklog" data-follow-url="/logs/{{ .Exec }}/{{ .Stack }}?follow=1" class="overflow-auto rounded-lg bg-neutral text-neutral-content p-4 text-xs" style="max-height:60vh"></pre>
          <a class="link text-xs" href="/logs/{{ .Exec }}/{{ .Stack }}">view full log →</a>
          <noscript>
            {{ if .LogExcerpt }}<pre class="overflow-auto rounded-lg bg-neutral text-neutral-content p-4 text-xs mt-2">{{ .LogExcerpt }}</pre>
            {{ else }}<p class="opacity-60 italic mt-2">No log captured for this stack.</p>{{ end }}
          </noscript>
        </div>
        <input type="radio" name="stacktabs" class="tab" aria-label="Plan">
        <div class="tab-content border-base-300 p-3">
          {{ if .Plan }}<pre class="overflow-auto rounded-lg bg-neutral text-neutral-content p-4 text-xs">{{ .Plan }}</pre>
          {{ else }}<p class="opacity-60 italic">No plan recorded for this stack.</p>{{ end }}
        </div>
        <input type="radio" name="stacktabs" class="tab" aria-label="Verify">
        <div class="tab-content border-base-300 p-3">
          {{ if .VerifyExec }}<a class="link link-hover" href="/live/{{ .VerifyExec }}">view the latest verify run →</a>
          {{ else }}<p class="opacity-60 italic">No verify run yet for this PR.</p>{{ end }}
        </div>
      </div>
    </div></section>
  </main>
  <script>
    (function () {
      var pre = document.getElementById("stacklog");
      if (!pre) return;
      try {
        var es = new EventSource(pre.dataset.followUrl);
        es.onmessage = function (e) {
          pre.textContent += e.data + "\n";
          pre.scrollTop = pre.scrollHeight;
        };
      } catch (e) { /* no EventSource → the noscript excerpt covers it */ }
    })();
  </script>
</body>
</html>
