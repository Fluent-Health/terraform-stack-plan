<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="min-h-screen bg-base-200">
  <div class="navbar bg-base-100 border-b border-base-300">
    <div class="mx-auto w-full max-w-5xl px-4">
      <a href="/" class="text-lg font-semibold link link-hover">tfstackplan</a>
      <span class="ml-3 text-sm opacity-60">{{ .Title }}</span>
    </div>
  </div>
  <main class="mx-auto w-full max-w-5xl px-4 py-6">
    <section class="card bg-base-100 shadow-sm"><div class="card-body p-2">
      {{ if .Rows }}
      <table class="table table-sm">
        <thead><tr><th>When</th><th>Repo</th><th>PR</th><th>Env</th><th>Phase</th><th>Status</th></tr></thead>
        <tbody>
          {{ range .Rows }}
          <tr class="hover">
            <td class="text-xs opacity-70">{{ .When }}</td>
            <td><a class="link link-hover" href="/live/{{ .ID }}"><code class="text-xs">{{ .ID }}</code></a> <span class="text-xs opacity-60">{{ .Repo }}</span></td>
            <td>{{ if .PR }}<a class="link link-hover" href="/pr/{{ .PR }}">#{{ .PR }}</a>{{ end }}</td>
            <td class="text-xs">{{ .Environment }}</td>
            <td class="text-xs">{{ .Phase }}</td>
            <td><span class="badge badge-sm {{ .StatusBadge }}">{{ .Status }}</span></td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ else }}<p class="opacity-60 italic p-4">No executions yet.</p>{{ end }}
    </div></section>
  </main>
</body>
</html>
