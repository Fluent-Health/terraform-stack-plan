<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <noscript><meta http-equiv="refresh" content="10"></noscript>
  <title>{{ .Title }} — {{ .Repo }}</title>
  <link rel="stylesheet" href="/assets/app.css">
  <link rel="stylesheet" href="/assets/report.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-base-200">
  <main class="mx-auto w-full max-w-4xl px-4 py-6">
    <div class="viewer-app">

      <div class="viewer-head">
        <div class="crumb">
          <span>{{ .Repo }}</span>
          {{ if gt .PR 0 }}· <a class="pnum" href="https://github.com/{{ .Repo }}/pull/{{ .PR }}">#{{ .PR }}</a>{{ end }}
          {{ if .ShortSHA }}· <span class="sha">{{ .ShortSHA }}</span>{{ end }}
          <span class="spacer">
            {{ if gt .PR 0 }}
            <a href="https://github.com/{{ .Repo }}/pull/{{ .PR }}" target="_blank" rel="noopener">PR ↗</a>
            <a href="https://github.com/{{ .Repo }}/pull/{{ .PR }}/checks" target="_blank" rel="noopener">Checks ↗</a>
            {{ else if .SHA }}
            <a href="https://github.com/{{ .Repo }}/commit/{{ .SHA }}" target="_blank" rel="noopener">Checks ↗</a>
            {{ end }}
          </span>
        </div>
        <div class="viewer-title">{{ .Title }} <span class="phase-pill phase-{{ .PhaseAccent }}">{{ .PhaseLabel }}{{ if .Elapsed }} · {{ .Elapsed }}{{ end }}</span></div>
      </div>

      <div class="verdict-band">
        <div class="verdict-nums">
          {{ with .Verdict }}
          {{ if .Add }}<div class="stat add"><span class="n">+{{ .Add }}</span><span class="l">add</span></div>{{ end }}
          {{ if .Change }}<div class="stat chg"><span class="n">~{{ .Change }}</span><span class="l">change</span></div>{{ end }}
          {{ if .Replace }}<div class="stat rep"><span class="n">±{{ .Replace }}</span><span class="l">replace</span></div>{{ end }}
          {{ if .Destroy }}<div class="stat del"><span class="n">−{{ .Destroy }}</span><span class="l">destroy</span></div>{{ end }}
          {{ if .Move }}<div class="stat mov"><span class="n">↔{{ .Move }}</span><span class="l">move</span></div>{{ end }}
          {{ end }}
        </div>
        <div class="blast-wrap">
          <div class="blast-label"><span>Blast radius</span><b>{{ .Verdict.TotalOps }} operations · {{ .StackCount }} stacks</b></div>
          <div class="blast-bar">
            {{ range .Blast }}<span class="blast-seg {{ .KindClass }}{{ if .Failed }} is-failed{{ else if not .Done }} is-pending{{ end }}" style="flex:{{ .Flex }}"></span>{{ end }}
          </div>
          <div class="chips">
            {{ if .Destructive }}<span class="chip dl">⚠ Destructive</span>{{ end }}
            {{ if .IAM }}<span class="chip iam">⚿ IAM changes</span>{{ end }}
            <span class="chip ops">{{ .Verdict.TotalOps }} operations</span>
          </div>
        </div>
      </div>

      {{ if .Panel }}<div class="viewer-section">{{ .Panel }}</div>{{ end }}

      <div class="viewer-section">
        <div class="viewer-section-title">Stacks</div>
        {{ range .Groups }}
        <div class="proj-group">
          <div class="proj-head"><span class="proj-name">{{ .Name }}</span><span class="proj-count">{{ len .Stacks }}</span></div>
          {{ range .Stacks }}
          <div class="stack-row">
            <span class="state-label state-{{ .State.CSS }}">{{ .State.Label }}</span>
            <span class="path"><a href="/live/{{ $.Exec }}/stack/{{ .Path }}">{{ .Path }}</a></span>
            {{ range .Risks }}<span class="risk-tag {{ .CSS }}">{{ .Label }}</span>{{ end }}
            <span class="op-count">{{ .Ops }}</span>
          </div>
          {{ end }}
        </div>
        {{ end }}
      </div>

      <div class="viewer-section">
        <details class="dag-accordion">
          <summary>Dependency graph</summary>
          <div class="dag-body">{{ .SVG }}</div>
        </details>
      </div>

      <div class="viewer-section">
        <div class="viewer-section-title">{{ if eq .PhaseAccent "apply" }}Apply report{{ else }}Plan report{{ end }}</div>
        {{ if .Report }}<div class="tfsp-report">{{ .ReportHTML }}</div>
        {{ else }}<p style="color:var(--c-muted);font-style:italic">Still running — the report appears here when it completes.</p>{{ end }}
      </div>

    </div>
  </main>
  <script>
    (function () {
      try {
        var es = new EventSource(location.pathname.replace(/\/$/, "") + "/events");
        var t;
        es.onmessage = function () { clearTimeout(t); t = setTimeout(function () { location.reload(); }, 800); };
      } catch (e) { /* no EventSource → the noscript meta-refresh covers it */ }
    })();
  </script>
</body>
</html>
