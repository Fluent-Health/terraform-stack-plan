<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <noscript><meta http-equiv="refresh" content="10"></noscript>
  <title>{{ .Title }}</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="min-h-screen bg-base-200">
  <div class="navbar bg-base-100 border-b border-base-300">
    <div class="mx-auto w-full max-w-5xl px-4">
      <span class="text-lg font-semibold">{{ .Title }}</span>
      <span class="ml-3 text-sm opacity-60">{{ .Repo }} · live</span>
    </div>
  </div>
  <main class="mx-auto w-full max-w-5xl px-4 py-6 space-y-6">
    {{ if .Panel }}<section class="card bg-base-100 shadow-sm"><div class="card-body p-4">{{ .Panel }}</div></section>{{ end }}
    <section class="card bg-base-100 shadow-sm"><div class="card-body p-4">
      <ul class="steps w-full">
        {{ range .Timeline }}
        <li class="step {{ if eq .State "done" }}step-success{{ else if eq .State "active" }}step-primary{{ end }}">{{ .Name }}</li>
        {{ end }}
      </ul>
    </div></section>
    <section class="card bg-base-100 shadow-sm"><div class="card-body p-4">
      <h2 class="text-sm font-semibold opacity-70 mb-2">Stacks</h2>
      {{ range .Groups }}
      <div tabindex="0" class="collapse collapse-arrow border border-base-300 rounded-lg mb-2">
        <input type="checkbox" checked>
        <div class="collapse-title text-sm font-medium">{{ .Name }} <span class="opacity-50">({{ len .Stacks }})</span></div>
        <div class="collapse-content">
          <ul class="divide-y divide-base-200">
            {{ range .Stacks }}
            <li class="flex items-center gap-3 py-1.5">
              <span class="badge {{ statusBadge .Status }} badge-sm">{{ .Status }}</span>
              <a class="link link-hover" href="/live/{{ $.Exec }}/stack/{{ .Path }}"><code class="text-xs">{{ .Path }}</code></a>
              {{ if .Detail }}<span class="text-xs opacity-60 truncate">{{ .Detail }}</span>{{ end }}
            </li>
            {{ end }}
          </ul>
        </div>
      </div>
      {{ end }}
    </div></section>
    <section class="card bg-base-100 shadow-sm"><div class="card-body p-4">
      <details open>
        <summary class="cursor-pointer text-sm font-semibold opacity-70">Dependency graph</summary>
        <div class="mt-3 flex justify-center">{{ .SVG }}</div>
      </details>
    </div></section>
    <section class="card bg-base-100 shadow-sm"><div class="card-body p-4">
      {{ if .Report }}<pre class="overflow-auto rounded-lg bg-neutral text-neutral-content p-4 text-xs">{{ .Report }}</pre>
      {{ else }}<p class="opacity-60 italic">Plan still running — the report appears here when the plan completes.</p>{{ end }}
    </div></section>
  </main>
  <script>
    (function () {
      try {
        var es = new EventSource(location.pathname.replace(/\/$/, "") + "/events");
        var t;
        es.onmessage = function () { clearTimeout(t); t = setTimeout(function () { location.reload(); }, 800); };
      } catch (e) { /* no EventSource → the noscript meta-refresh covers it */ }
    })();
  </script>
</body>
</html>
