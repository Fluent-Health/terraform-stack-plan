<!doctype html>
<html lang="en" data-theme="briefing" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <noscript><meta http-equiv="refresh" content="10"></noscript>
  <title>{{ .Title }} — {{ .Repo }}</title>
  <link rel="stylesheet" href="/assets/app.css">
  <link rel="stylesheet" href="/assets/report.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-base-200">
  <main class="mx-auto w-full max-w-4xl px-4 py-6">
    <div class="card bg-base-100 border border-base-300 shadow-sm">

      <!-- header -->
      <div class="p-5 border-b border-base-300">
        <div class="flex items-center gap-2 flex-wrap font-mono text-xs text-base-content/60 mb-2">
          <span>{{ .Repo }}</span>
          {{ if gt .PR 0 }}<span>·</span><a class="text-primary" href="https://github.com/{{ .Repo }}/pull/{{ .PR }}">#{{ .PR }}</a>{{ end }}
          {{ if .ShortSHA }}<span>·</span><span class="bg-base-200 rounded px-1.5">{{ .ShortSHA }}</span>{{ end }}
          <span class="ml-auto flex gap-3">
            {{ if gt .PR 0 }}
            <a href="https://github.com/{{ .Repo }}/pull/{{ .PR }}" target="_blank" rel="noopener">PR ↗</a>
            <a href="https://github.com/{{ .Repo }}/pull/{{ .PR }}/checks" target="_blank" rel="noopener">Checks ↗</a>
            {{ else if .SHA }}
            <a href="https://github.com/{{ .Repo }}/commit/{{ .SHA }}" target="_blank" rel="noopener">Checks ↗</a>
            {{ end }}
          </span>
        </div>
        <h1 class="font-display text-xl font-bold flex items-center gap-3 flex-wrap">
          {{ .Title }}
          <span class="badge badge-sm font-mono tracking-wide {{ if eq .PhaseAccent "apply" }}badge-primary{{ else }}badge-secondary{{ end }}">{{ .PhaseLabel }}{{ if .Elapsed }} · {{ .Elapsed }}{{ end }}</span>
        </h1>
      </div>

      <!-- verdict counts + progress -->
      <div class="p-5 bg-base-200/40 border-b border-base-300 flex flex-col gap-3">
        <div class="flex items-center gap-5 flex-nowrap overflow-x-auto">
          {{ with .Verdict }}
          {{ if .Add }}<div class="flex flex-col shrink-0"><span class="font-display text-2xl font-bold leading-none text-success">+{{ .Add }}</span><span class="text-[10px] uppercase tracking-wide text-base-content/50">add</span></div>{{ end }}
          {{ if .Change }}<div class="flex flex-col shrink-0"><span class="font-display text-2xl font-bold leading-none text-warning">~{{ .Change }}</span><span class="text-[10px] uppercase tracking-wide text-base-content/50">change</span></div>{{ end }}
          {{ if .Replace }}<div class="flex flex-col shrink-0"><span class="font-display text-2xl font-bold leading-none text-accent">±{{ .Replace }}</span><span class="text-[10px] uppercase tracking-wide text-base-content/50">replace</span></div>{{ end }}
          {{ if .Destroy }}<div class="flex flex-col shrink-0"><span class="font-display text-2xl font-bold leading-none text-error">−{{ .Destroy }}</span><span class="text-[10px] uppercase tracking-wide text-base-content/50">destroy</span></div>{{ end }}
          {{ if .Move }}<div class="flex flex-col shrink-0"><span class="font-display text-2xl font-bold leading-none text-info">↔{{ .Move }}</span><span class="text-[10px] uppercase tracking-wide text-base-content/50">move</span></div>{{ end }}
          {{ end }}
          {{ if .IAMCount }}<div class="flex flex-col shrink-0"><span class="font-display text-2xl font-bold leading-none text-warning">⚿{{ .IAMCount }}</span><span class="text-[10px] uppercase tracking-wide text-base-content/50">iam</span></div>{{ end }}
          {{ if .Destructive }}<span class="badge badge-sm badge-error shrink-0">⚠ Destructive</span>{{ end }}
        </div>
        <div>
          <div class="flex justify-between text-xs text-base-content/50 mb-1.5"><span>Progress</span><span class="font-mono text-base-content">{{ .Verdict.TotalOps }} operations · {{ .StackCount }} stacks</span></div>
          <div class="progress-bar">
            {{ range .Progress }}<span class="bar-seg bs-{{ .StateCSS }}" style="flex:{{ .Flex }}"></span>{{ end }}
          </div>
        </div>
      </div>

      {{ if .Panel }}<div class="p-5 border-b border-base-300">{{ .Panel }}</div>{{ end }}

      {{ if .Failures }}
      <div class="p-5 border-b border-base-300">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-error mb-3">⚠ Needs attention</h2>
        {{ range .Failures }}
        <div class="triage-card">
          <div class="triage-head"><span class="text-error font-semibold">✗ {{ .Path }}</span>
            {{ if .Class }}<span class="badge badge-sm badge-error badge-outline">{{ .Class }}</span>{{ end }}
            <a class="ml-auto text-xs text-primary" href="#{{ .Anchor }}">view detail</a></div>
          {{ if .Cause }}<p class="triage-cause"><b>Likely cause.</b> {{ .Cause }}</p>{{ end }}
          {{ if .Detail }}<pre class="term text-xs" style="max-height:11rem">{{ .Detail }}</pre>{{ end }}
          <div class="triage-grid">
            <div><div class="triage-label">Next steps</div><ol class="triage-steps">{{ range .Steps }}<li>{{ . }}</li>{{ end }}</ol>
              <a class="text-xs text-primary" href="{{ .LogURL }}" target="_blank" rel="noopener">full log ↗</a></div>
            {{ if .StateImpact }}<div><div class="triage-label">State impact</div><p class="text-sm">{{ .StateImpact }}</p></div>{{ end }}
          </div>
        </div>
        {{ end }}
      </div>
      {{ end }}

      <!-- stacks, grouped by Google project -->
      <div class="p-5 border-b border-base-300">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-3">Stacks</h2>
        {{ range .Groups }}
        <div class="mb-3 last:mb-0">
          <div class="flex items-center gap-3 px-1 mb-1">
            <span class="font-mono text-sm font-semibold text-base-content/80">{{ .Name }}</span>
            <span class="ml-auto font-mono text-xs text-base-content/50">{{ len .Stacks }}</span>
          </div>
          <ul class="menu menu-sm w-full gap-0.5 p-0">
            {{ range .Stacks }}
            <li>
              <a class="flex items-center gap-3.5" href="#{{ .Anchor }}">
                <span class="w-28 shrink-0 font-semibold sl-{{ .State.CSS }}">{{ .State.Label }}</span>
                <span class="flex-1 font-mono text-sm">{{ .Path }}</span>
                {{ range .Risks }}<span class="badge badge-xs {{ if eq .CSS "danger" }}badge-error{{ else }}badge-warning{{ end }}">{{ .Label }}</span>{{ end }}
                <span class="w-12 text-right font-mono text-xs text-base-content/50">{{ .Ops }}</span>
              </a>
            </li>
            {{ end }}
          </ul>
        </div>
        {{ end }}
      </div>

      <!-- selected-stack detail: clicking a row above swaps this ONE pane
           (CSS :target — only the selected stack shows; first shows by default) -->
      <div class="p-5 border-b border-base-300">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-3">{{ if eq .PhaseAccent "apply" }}Apply detail{{ else }}Plan detail{{ end }}</h2>
        <div class="detail-wrap">
          <p class="detail-empty italic text-base-content/40 text-sm">Select a stack above to view its plan or log.</p>
          {{ range .Groups }}{{ range .Stacks }}
          <section id="{{ .Anchor }}" class="stack-detail scroll-mt-4">
            <div class="flex items-center gap-3 mb-2">
              <span class="font-mono text-sm font-semibold">{{ .Path }}</span>
              <span class="text-xs font-semibold sl-{{ .State.CSS }}">{{ .State.Label }}</span>
              {{ range .Risks }}<span class="badge badge-xs {{ if eq .CSS "danger" }}badge-error{{ else }}badge-warning{{ end }}">{{ .Label }}</span>{{ end }}
              <a class="ml-auto text-xs text-primary" href="{{ .DetailURL }}" target="_blank" rel="noopener">raw log ↗</a>
            </div>
            <div class="tabs tabs-lift">
              <label class="tab"><input type="radio" name="tab-{{ .Anchor }}" checked>Result</label>
              <div class="tab-content border-base-300 p-3">
                {{ if .Detail }}<div class="tfsp-report">{{ .Detail }}</div>
                {{ else if .Follow }}<div class="shimmer h-24 w-full rounded"></div><p class="italic text-base-content/40 text-xs mt-2">Planning…</p>
                {{ else }}<p class="italic text-base-content/40 text-sm">No plan recorded for this stack.</p>{{ end }}
              </div>
              <label class="tab">Log{{ if .Follow }}<span class="live-dot" title="streaming live"></span>{{ end }}<input type="radio" name="tab-{{ .Anchor }}"></label>
              <div class="tab-content border-base-300 p-3">
                <pre class="term text-xs" style="max-height:60vh" data-stack="{{ .Path }}" data-log-url="/logs/{{ $.Exec }}/{{ .Path }}"{{ if .Follow }} data-follow-url="/logs/{{ $.Exec }}/{{ .Path }}?follow=1"{{ end }}>{{ .LogExcerpt }}</pre>
              </div>
              {{ if eq $.PhaseAccent "apply" }}{{ if $.VerifyExec }}
              <label class="tab">Validation{{ if not $.Finished }}<span class="live-dot" title="streaming live"></span>{{ end }}<input type="radio" name="tab-{{ .Anchor }}"></label>
              <div class="tab-content border-base-300 p-3">
                <pre class="term text-xs" style="max-height:60vh" data-log-url="/logs/{{ $.VerifyExec }}/{{ .Path }}"{{ if not $.Finished }} data-follow-url="/logs/{{ $.VerifyExec }}/{{ .Path }}?follow=1"{{ end }}></pre>
              </div>
              {{ end }}{{ end }}
            </div>
          </section>
          {{ end }}{{ end }}
        </div>
      </div>

      <!-- dependency graph (demoted, reference) -->
      <div class="p-5">
        <div class="collapse collapse-arrow">
          <input type="checkbox">
          <div class="collapse-title min-h-0 px-0 py-0 font-semibold text-sm text-base-content/70">Dependency graph</div>
          <div class="collapse-content px-0"><div class="flex justify-center pt-3">{{ .SVG }}</div></div>
        </div>
      </div>

    </div>
  </main>
  <script>
    // Page-level live refresh: reload on any execution STATE change (a stack
    // starts/finishes, gate changes). Log chunks publish to a different SSE topic,
    // so they don't trigger this — the watched log streams smoothly between
    // transitions, and a reload re-renders the truthful state (e.g. drops the Log
    // tab's live dot once the run finishes). The selected stack re-streams via the
    // hash after reload.
    (function () {
      try {
        var es = new EventSource(location.pathname.replace(/\/$/, "") + "/events");
        var t;
        es.onmessage = function () { clearTimeout(t); t = setTimeout(function () { location.reload(); }, 800); };
      } catch (e) { /* no EventSource → the noscript meta-refresh covers it */ }
    })();
  </script>
  <script>
    // Selected-stack log: clicking a row sets the hash (CSS :target shows the
    // pane); this opens ONE EventSource for that stack's log, closing the prior.
    // ANSI SGR colours are parsed client-side into <span class="a-*">; all log
    // bytes are HTML-escaped before insertion (logs are attacker-influenceable).
    (function () {
      var es = null, cur = null;
      var MAP = {31:'a-red',32:'a-green',33:'a-yellow',34:'a-blue',35:'a-magenta',36:'a-cyan',90:'a-grey',
                 91:'a-red',92:'a-green',93:'a-yellow',94:'a-blue',95:'a-magenta',96:'a-cyan'};
      function esc(s){ return s.replace(/[&<>]/g, function (c){ return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }); }
      function cls(codes){ var c=[]; codes.split(';').forEach(function(n){ n=+n; if(n===1)c.push('a-bold'); else if(MAP[n])c.push(MAP[n]); }); return c.join(' '); }
      function ansi(line){
        var out='', open=0, re=/\x1b\[([0-9;]*)m/g, last=0, m;
        while ((m=re.exec(line))){
          out+=esc(line.slice(last,m.index)); last=re.lastIndex;
          if (open){ out+='</span>'; open=0; }
          var codes=m[1]||'0';
          if (codes!=='0' && codes!==''){ var c=cls(codes); if(c){ out+='<span class="'+c+'">'; open=1; } }
        }
        out+=esc(line.slice(last)); if (open) out+='</span>';
        return out;
      }
      window.__tfspAnsi = ansi;
      function append(pre, data){ pre.insertAdjacentHTML('beforeend', ansi(data)+'\n'); pre.scrollTop = pre.scrollHeight; }
      function close(){ if (es){ es.close(); es=null; } }
      function stream(id){
        close(); cur=id;
        var pane = id && document.getElementById(id); if (!pane) return;
        var pre = pane.querySelector('pre[data-follow-url]'); if (!pre) return;
        pre.textContent=''; // the SSE replays the buffer from the start
        try {
          es = new EventSource(pre.dataset.followUrl);
          es.onmessage = function (e){ if (cur===id) append(pre, e.data); };
          es.onerror = function (){ /* keep the buffer already shown; EventSource auto-retries */ };
        } catch (_) { /* no EventSource → the seeded excerpt remains */ }
      }
      // finished/validation panes have only data-log-url → fetch once when shown.
      function staticFill(id){
        var pane = id && document.getElementById(id); if (!pane) return;
        pane.querySelectorAll('pre[data-log-url]:not([data-follow-url])').forEach(function (pre){
          if (pre.dataset.filled) return; pre.dataset.filled='1';
          fetch(pre.dataset.logUrl).then(function (r){ return r.ok ? r.text() : ''; }).then(function (t){
            pre.innerHTML = t.split('\n').map(window.__tfspAnsi).join('\n');
          }).catch(function (){});
        });
      }
      function onHash(){ var h = location.hash.slice(1); stream(h); staticFill(h); }
      window.addEventListener('hashchange', onHash);
      if (location.hash) onHash();
    })();
  </script>
</body>
</html>
