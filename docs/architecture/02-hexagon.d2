vars: {
  d2-config: {
    theme-overrides: {
      B1: "#495AE4"; B2: "#DADCFF"; B3: "#BEF0E4"; B4: "#D6E8FF"
      B5: "#289673"; B6: "#144037"
      AA2: "#FF6333"; AA4: "#FF6333"; AA5: "#FF6333"
      N1: "#14181A"; N2: "#323241"; N3: "#858C8F"; N4: "#E7E8E9"
      N5: "#F5F0E8"; N6: "#FFF2DF"; N7: "#FFFFFF"
    }
  }
}

direction: right

cap: "tfstackplan — Hexagonal: one pure domain core, driving adapters in, driven ports out" {
  near: top-center
  shape: text
  style: { font-size: 22; bold: true; font-color: "#14181A" }
}

driving: "Driving adapters\n(outside world → Commands)" {
  style: { fill: "#DADCFF"; stroke: "#495AE4"; stroke-width: 2; border-radius: 12; font-color: "#14181A"; bold: true }
  cli: "CLI subcommands" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  http: "HTTP /api/*" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  hook: "GitHub webhook" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  pubsub: "Pub/Sub push" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  timers: "Timers\n(reconcile · sweeps)" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
}

core: "Domain core (pure · no I/O)" {
  style: { fill: "#BEF0E4"; stroke: "#289673"; stroke-width: 2; border-radius: 12; font-color: "#14181A"; bold: true }
  model: "canonical model\nStatus · Counts · Category · Gate · Claim" { style: { fill: "#FFFFFF"; stroke: "#289673"; border-radius: 8; font-color: "#14181A" } }
  pipeline: "render pipeline\ngather → fit → render" { style: { fill: "#FFFFFF"; stroke: "#289673"; border-radius: 8; font-color: "#14181A" } }
  classify: "classify + differ" { style: { fill: "#FFFFFF"; stroke: "#289673"; border-radius: 8; font-color: "#14181A" } }
  decider: "deciders\nDecide · Evolve · React" { style: { fill: "#FFFFFF"; stroke: "#289673"; border-radius: 8; font-color: "#14181A"; bold: true } }
}

ports: "Driven ports (interfaces)" {
  style: { fill: "#495AE4"; stroke: "#3F51E3"; stroke-width: 2; border-radius: 12; font-color: "#FFFFFF"; bold: true }
  eventstore: "EventStore" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#495AE4"; bold: true } }
  github: "GitHub" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#495AE4" } }
  approval: "Approval.Backend" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#495AE4" } }
  objects: "ObjectStore" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#495AE4" } }
  terramate: "Terramate" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#495AE4" } }
  clock: "Clock" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#495AE4" } }
}

adapters: "Driven adapters (implementations)" {
  style: { fill: "#D6E8FF"; stroke: "#495AE4"; stroke-width: 2; border-radius: 12; font-color: "#14181A"; bold: true }
  sqlite: "SQLite event log\n+ snapshots" { shape: cylinder; style: { fill: "#FFFFFF"; stroke: "#495AE4"; font-color: "#14181A" } }
  ghreal: "RealClient\n(GitHub REST + App JWT)" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  gcppam: "gcppam\n(GCP PAM)" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  gcsfs: "GCS / FSStore" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  tmbin: "terramate binary" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
  realclock: "system clock" { style: { fill: "#FFFFFF"; stroke: "#495AE4"; border-radius: 8; font-color: "#14181A" } }
}

driving.cli -> core.decider
driving.http -> core.decider
driving.hook -> core.decider
driving.pubsub -> core.decider
driving.timers -> core.decider
core.decider -> core.model
core.pipeline -> core.model
core.classify -> core.model

core.decider -> ports.eventstore
core.decider -> ports.github
core.decider -> ports.approval
core.decider -> ports.objects
core.classify -> ports.terramate
core.decider -> ports.clock

ports.eventstore -> adapters.sqlite
ports.github -> adapters.ghreal
ports.approval -> adapters.gcppam
ports.objects -> adapters.gcsfs
ports.terramate -> adapters.tmbin
ports.clock -> adapters.realclock
